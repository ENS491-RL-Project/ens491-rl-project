#!/bin/sh
# Rebuild the graphify code graph before each commit and stage it, so
# graphify-out/ always lands in the same commit as the code it describes.
# Install per clone:  cp .githooks/pre-commit .git/hooks/pre-commit
# Never blocks a commit: without graphify, or if the rebuild fails, it only warns.
# Skip once with GRAPHIFY_SKIP_HOOK=1 git commit ...

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0

# Only staged files outside graphify-out/ can change the graph.
OUT="${GRAPHIFY_OUT:-graphify-out}"
OUT="${OUT%/}"
if ! git diff --cached --name-only | grep -qv "^$OUT/"; then
    exit 0
fi

# GUI clients (VS Code, desktop apps) often lack ~/.local/bin on PATH.
GRAPHIFY=$(command -v graphify 2>/dev/null)
[ -z "$GRAPHIFY" ] && [ -x "$HOME/.local/bin/graphify" ] && GRAPHIFY="$HOME/.local/bin/graphify"
if [ -z "$GRAPHIFY" ]; then
    echo "[graphify pre-commit] graphify not installed; graph not updated (see CLAUDE.md)." >&2
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 0
# Deterministic clustering, same as graphify's own hooks.
if ! PYTHONHASHSEED=0 "$GRAPHIFY" update . >/dev/null 2>&1; then
    echo "[graphify pre-commit] graphify update failed; committing without a graph update." >&2
    exit 0
fi
git add -- "$OUT"
exit 0
